PORT=4000
DATABASE_URL=postgres://safebiz:changeme@localhost:5432/safe_business
JWT_SECRET=change_this_to_a_long_random_string
# 32-байтный ключ (64 hex-символа) для шифрования данных аудита
# безопасности (core/crypto.js). Сгенерировать:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECURITY_ENCRYPTION_KEY=change_this_to_a_64_char_hex_string
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Базовый URL корня сайта (БЕЗ /lk) — нужен только для roadmap.routes.js
# (публичные страницы landing/start.html и landing/roadmap.html, продукт
# "roadmap открытия бизнеса", живут в корне домена, не в /lk). На проде —
# https://business-safe.ru. Без него собирается из самого запроса.
SITE_URL=

# Продукт "roadmap открытия бизнеса" целиком выключен, пока здесь не стоит
# true — тихая обкатка (10.08.2026), включать явно, когда решим показать
# всем. Страницы landing/start.html и landing/roadmap.html без этого флага
# показывают "скоро запуск" вместо формы.
ROADMAP_PRODUCT_ENABLED=

# Путь к системному Chromium для Puppeteer (platform/journalGenerator.js —
# печатные PDF-журналы). Нужно, только если запуск скачанного Puppeteer'ом
# бинарника падает на сервере с "cannot open shared object file" — поставить
# `apt-get install -y chromium` и указать сюда путь (обычно /usr/bin/chromium,
# проверить: `which chromium`). Пусто — используется бинарник самого Puppeteer.
PUPPETEER_EXECUTABLE_PATH=

# Push-уведомления (Пакет 3, Этап 9, Web Push API). Без этих двух ключей
# core/pushNotify.js молча не отправляет push (не роняет остальной код) —
# сгенерировать пару:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@safe-business.local

# Учётные данные первого владельца, создаваемые скриптом `npm run seed`
SEED_OWNER_NAME=Владелец
SEED_OWNER_EMAIL=owner@example.com
SEED_OWNER_PASSWORD=change_me_123

# Автопроверка после деплоя (Задача 0, backend/src/scripts/smokeCheck.js) —
# отдельная служебная компания, не пересекается с реальными клиентами.
# Создаётся один раз скриптом `node src/db/seedSmokeTest.js` (deploy.sh
# запускает его автоматически). SMOKE_APP_URL — адрес, по которому
# автопроверка стучится сама в себя после деплоя (по умолчанию localhost).
SMOKE_APP_URL=http://localhost
SMOKE_OWNER_EMAIL=smoke-owner@example.com
SMOKE_OWNER_PASSWORD=change_me_smoke_owner
SMOKE_ADMIN_EMAIL=smoke-admin@example.com
SMOKE_ADMIN_PASSWORD=change_me_smoke_admin
SMOKE_MASTER_EMAIL=smoke-master@example.com
SMOKE_MASTER_PASSWORD=change_me_smoke_master

# Онлайн-оплата подписки через ЮKassa (backend/src/core/yookassa.js).
# Тестовые и боевые ключи берутся из личного кабинета ЮKassa — тестовый
# secretKey обычно начинается с test_, боевой — с live_. Никакой отдельный
# "тестовый режим" в коде не переключается — какие ключи здесь, с тем
# магазином и работаем. Вебхук нужно один раз указать в настройках магазина:
# https://<домен>/api/platform/subscription/webhook
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Черновики ответов поддержки от ИИ (core/aiAssist.js, "Фаза 1" из плана
# ИИ-второго-собственника). Без ANTHROPIC_API_KEY кнопка "Черновик от ИИ" в
# админке молча недоступна (как push без VAPID-ключей) — остальной код не
# ломается. Ключ — на https://console.anthropic.com. ANTHROPIC_MODEL можно
# не задавать — по умолчанию claude-opus-4-8.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# ИИ-советник по марже (core/yandexAssist.js, Этап 6 плана аналитики) —
# отдельная фича на YandexGPT (Yandex Foundation Models), не Anthropic,
# осознанный выбор владельца. Без обеих переменных ниже эндпоинт
# /api/modules/finance/margin-advisor молча отдаёт только цифры (расчёт
# маржи — чистая математика, ИИ не нужен для него), без текстовой
# рекомендации — остальной код не ломается. Ключ и folder id — в консоли
# Yandex Cloud (сервисный аккаунт с ролью ai.languageModels.user).
YANDEX_GPT_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_GPT_MODEL=

# Отправка писем (core/mailer.js) — подтверждение регистрации, ссылка для
# сброса пароля. SMTP вместо отдельного сервиса — доменная почта на
# Яндекс 360 для бизнеса. SMTP_PASSWORD — это "пароль приложения" ящика
# (Яндекс.Почта → Безопасность → Пароли приложений), НЕ пароль от самого
# ящика. MAIL_FROM можно не задавать — по умолчанию берётся SMTP_USER.
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=noreply@business-safe.ru
SMTP_PASSWORD=
MAIL_FROM=noreply@business-safe.ru
