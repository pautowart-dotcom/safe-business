# Скопируйте в .env и заполните. .env в git не попадает.

# Токен НОВОГО бота от @BotFather (не @business_safe_bot). В BotFather включить Business Mode.
STUDIO_BOT_TOKEN=

# id группы «Админ», куда бот шлёт карточки. Узнать: добавить бота в группу и написать там /chatid
ADMIN_CHAT_ID=

# YandexGPT (Yandex Cloud Foundation Models): статический API-ключ сервисного аккаунта и id каталога
YANDEX_GPT_API_KEY=
YANDEX_FOLDER_ID=
# yandexgpt/latest — полная модель; yandexgpt-lite/latest — дешевле, проверить на test/voprosy.txt
YANDEX_GPT_MODEL=yandexgpt/latest
